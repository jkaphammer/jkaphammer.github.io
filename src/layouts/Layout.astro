---
import "../styles/global.css";
import EmailIcon from "../components/icons/EmailIcon.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Kaphammer | Portfolio",
	description = "Portfolio site for Jenn Kaphammer featuring projects, experience, and contact information.",
} = Astro.props;

const pathname = Astro.url.pathname;
const navigation = [
	{ href: "/", label: "Home" }
	// { href: "/projects", label: "Projects" },
	// { href: "/about", label: "About" }
];

const contactLinks = [
	{
		href: "https://github.com/jkaphammer",
		label: "GitHub",
		external: true,
	},
	{
		href: "https://linkedin.com/in/jenn-kaphammer",
		label: "LinkedIn",
		external: true,
	},
	{
		href: "mailto:jennkaphammer@gmail.com",
		label: "Email",
		external: false,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-w-80 bg-theme-bg font-sans text-theme-ink antialiased">
		<div class="relative isolate min-h-screen overflow-x-hidden">
			<div class="pointer-events-none fixed left-[-8rem] top-24 -z-10 h-72 w-72 rounded-full bg-sky-aqua-300/20 blur-3xl"></div>
			<div class="pointer-events-none fixed bottom-28 right-[-4rem] -z-10 h-56 w-56 rounded-full bg-tea-green-300/18 blur-3xl"></div>
			<div class="pointer-events-none fixed right-[18%] top-[10%] -z-10 h-40 w-40 rounded-full bg-midnight-violet-200/12 blur-3xl"></div>

			<header class="mx-auto w-full max-w-site px-4 pt-4 sm:px-6 lg:px-8">
				<div class="flex flex-wrap items-center justify-between gap-3 rounded-full border border-baltic-blue-200/60 bg-theme-panel/70 px-4 py-3 shadow-soft backdrop-blur-xl md:px-6">
					<a href="/" class="text-sm font-semibold tracking-[0.22em] text-baltic-blue-900 uppercase">
						Jenn Kaphammer
					</a>

					<div class="flex items-center gap-3">
						<nav aria-label="Primary navigation">
							<ul class="flex items-center gap-1 text-sm text-baltic-blue-700 sm:gap-2">
								{navigation.map((item) => {
									const isActive = pathname === item.href;

									return (
										<li>
											<a
												href={item.href}
												aria-current={isActive ? "page" : undefined}
												class:list={[
													"rounded-full px-3 py-2 transition duration-200",
													isActive
														? "bg-baltic-blue-100 text-baltic-blue-900 shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--palette-baltic-blue-200)_70%,transparent)]"
														: "hover:bg-white/55 hover:text-baltic-blue-900",
												]}
											>
												{item.label}
											</a>
										</li>
									);
								})}
							</ul>
						</nav>

						<div class="flex items-center gap-1.5 border-l border-baltic-blue-200/70 pl-2 sm:pl-3">
							{contactLinks.map((link) => (
								<a
									href={link.href}
									aria-label={link.label}
									target={link.external ? "_blank" : undefined}
									rel={link.external ? "noreferrer" : undefined}
									class="rounded-full p-2 text-baltic-blue-700 transition duration-200 hover:bg-white/55 hover:text-baltic-blue-900"
								>
									{link.label === "GitHub" && <GitHubIcon class="h-5 w-5 fill-current" />}
									{link.label === "LinkedIn" && <LinkedInIcon class="h-5 w-5 fill-current" />}
									{link.label === "Email" && <EmailIcon class="h-5 w-5 fill-current" />}
								</a>
							))}
						</div>
					</div>
				</div>
			</header>

			<slot />
		</div>
	</body>
</html>
