---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout
	title="Jenn Kaphammer | Projects"
	description="Projects and case studies from Jenn Kaphammer."
>
	<main class="mx-auto w-full max-w-site px-4 py-10 sm:px-6 lg:px-8">
		<section class="rounded-panel border border-theme-line bg-theme-panel/80 p-6 shadow-soft backdrop-blur md:p-8">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand-700">Projects</p>
			<h1 class="font-display text-4xl leading-tight tracking-[-0.04em] text-theme-ink sm:text-5xl">
				Project pages can live here.
			</h1>
			<p class="mt-4 max-w-2xl text-base leading-8 text-theme-muted">
				Each file you add in <code class="rounded bg-brand-100 px-2 py-1 text-sm text-brand-700">src/pages/</code>
				becomes its own route in Astro, which makes it easy to grow this into separate project and
				case study pages.
			</p>
		</section>
	</main>
</BaseLayout>
