---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout
	title="Kaphammer | Projects"
	description="Projects and case studies from Jenn Kaphammer."
>
	<main class="mx-auto w-full max-w-site px-4 py-10 sm:px-6 lg:px-8">
		<section class="rounded-panel border border-midnight-violet-200/45 bg-[linear-gradient(145deg,color-mix(in_oklab,var(--palette-sky-aqua-50)_62%,white),color-mix(in_oklab,var(--palette-midnight-violet-50)_32%,white))] p-6 shadow-soft backdrop-blur md:p-8">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-midnight-violet-700">Projects</p>
			<h1 class="font-display text-4xl leading-tight tracking-[-0.04em] text-baltic-blue-950 sm:text-5xl">
				Projects
			</h1>
			<p class="mt-4 max-w-2xl text-base leading-8 text-baltic-blue-700">
				In-progress
			</p>
		</section>
	</main>
</BaseLayout>
