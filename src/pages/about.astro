---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout
	title="Kaphammer | About Me"
	description="About Jenn Kaphammer."
>
	<main class="mx-auto w-full max-w-site px-4 py-10 sm:px-6 lg:px-8">
		<section class="rounded-panel border border-baltic-blue-200/60 bg-[linear-gradient(145deg,color-mix(in_oklab,var(--palette-rosy-granite-50)_78%,white),color-mix(in_oklab,var(--palette-sky-aqua-50)_30%,white))] p-6 shadow-soft backdrop-blur md:p-8">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-baltic-blue-700">About</p>
			<h1 class="font-display text-4xl leading-tight tracking-[-0.04em] text-baltic-blue-950 sm:text-5xl">
				About Me
			</h1>
			<p class="mt-4 max-w-2xl text-base leading-8 text-baltic-blue-700">
				In-progress
			</p>
		</section>
	</main>
</BaseLayout>
