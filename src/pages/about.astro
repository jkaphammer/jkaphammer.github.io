---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout
	title="Jenn Kaphammer | About"
	description="About Jenn Kaphammer."
>
	<main class="mx-auto w-full max-w-site px-4 py-10 sm:px-6 lg:px-8">
		<section class="rounded-panel border border-theme-line bg-theme-panel/80 p-6 shadow-soft backdrop-blur md:p-8">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand-700">About</p>
			<h1 class="font-display text-4xl leading-tight tracking-[-0.04em] text-theme-ink sm:text-5xl">
				Your fuller story can live here.
			</h1>
			<p class="mt-4 max-w-2xl text-base leading-8 text-theme-muted">
				This page is a good home for your background, values, strengths, and the kind of work you
				want to do more of.
			</p>
		</section>
	</main>
</BaseLayout>
