---
import BaseLayout from "../layouts/Layout.astro";

const focusAreas = [
	"Frontend development with accessible, human-centered UI decisions",
	"Thoughtful collaboration across design, product, and engineering",
	"Clear case studies that explain both process and outcome",
];
---

<BaseLayout
	title="Jenn Kaphammer | Home"
	description="Introductory homepage for Jenn Kaphammer's portfolio."
>
	<main class="mx-auto flex min-h-[calc(100vh-5rem)] w-full max-w-site items-center px-4 pb-16 pt-8 sm:px-6 lg:px-8">
		<section class="grid w-full gap-6 lg:grid-cols-[minmax(0,1.35fr)_22rem] lg:items-stretch">
			<div class="rounded-panel border border-theme-line bg-theme-panel/80 p-6 shadow-soft backdrop-blur md:p-8 lg:p-10">
				<p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand-700">
					Portfolio in progress
				</p>
				<h1 class="max-w-3xl font-display text-5xl leading-[0.95] tracking-[-0.04em] text-theme-ink sm:text-6xl lg:text-7xl">
					Hi, I'm Jenn. I build thoughtful digital experiences and I care about how they feel to use.
				</h1>
				<p class="mt-6 max-w-2xl text-base leading-8 text-theme-muted sm:text-lg">
					This homepage is intentionally simple so it can act as a strong introduction. As the
					site grows, the navigation will carry the deeper story through dedicated projects,
					about, and contact pages.
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a
						href="/projects"
						class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-700"
					>
						View projects
					</a>
					<a
						href="/about"
						class="inline-flex items-center justify-center rounded-full border border-theme-line bg-white/60 px-6 py-3 text-sm font-semibold text-theme-ink transition hover:-translate-y-0.5 hover:bg-white/80"
					>
						Read more about me
					</a>
				</div>
			</div>

			<aside class="rounded-panel border border-theme-line bg-theme-surface p-6 shadow-soft backdrop-blur md:p-8">
				<p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand-700">
					What belongs here
				</p>
				<h2 class="font-display text-3xl leading-tight tracking-[-0.03em] text-theme-ink">
					A quick snapshot of your strengths
				</h2>
				<ul class="mt-6 space-y-4 text-sm leading-7 text-theme-muted">
					{focusAreas.map((area) => (
						<li class="flex gap-3">
							<span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-brand-500"></span>
							<span>{area}</span>
						</li>
					))}
				</ul>
			</aside>
		</section>
	</main>
</BaseLayout>
