---
import BaseLayout from "../layouts/Layout.astro";

const focusAreas = [
	"Python & SQL",
	"Professional gigging musician - songwriting, drums, percussion",
];
---

<BaseLayout
	title="Kaphammer | Home"
	description="Introductory homepage for Jenn Kaphammer's portfolio."
>
	<main class="mx-auto flex min-h-[calc(100vh-5rem)] w-full max-w-site items-center px-4 pb-16 pt-8 sm:px-6 lg:px-8">
		<section class="grid w-full justify-items-center gap-6 lg:items-stretch">
			<div class="relative w-full max-w-4xl overflow-hidden rounded-panel border border-baltic-blue-200/60 bg-[linear-gradient(145deg,color-mix(in_oklab,var(--palette-sky-aqua-50)_68%,white),color-mix(in_oklab,var(--palette-rosy-granite-50)_74%,white))] p-6 shadow-soft backdrop-blur md:p-8 lg:p-10">
				<div class="pointer-events-none absolute right-[-3rem] top-[-3rem] h-36 w-36 rounded-full bg-sky-aqua-300/28 blur-3xl"></div>
				<div class="pointer-events-none absolute bottom-[-4rem] left-[22%] h-40 w-40 rounded-full bg-midnight-violet-200/10 blur-3xl"></div>

				<p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-baltic-blue-700">
					Portfolio in progress
				</p>
				<h1 class="relative z-10 max-w-3xl font-display text-5xl leading-[0.92] tracking-[-0.05em] text-baltic-blue-950 sm:text-6xl lg:text-7xl">
					Hi, I'm Jenn!
				</h1>
				<p class="relative z-10 mt-6 max-w-2xl text-base leading-8 text-baltic-blue-700 sm:text-lg">
					My interactive website is under-construction. Thanks for checking it out!
          Reach out to me via LinkedIn or email.
				</p>

