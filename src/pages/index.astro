---
import BaseLayout from "../layouts/Layout.astro";
import SignalCanvas from "../components/SignalCanvas.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import { projects } from "../data/projects";
import MusicPlayer from "../components/MusicPlayer.astro";

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout
  title="Home | J. Kaphammer"
  description="Software engineering, audio technology, and interactive systems."
>
  <main class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12">

    <!-- Typographic hero -->
    <section class="relative grid gap-12 border-b border-baltic-blue-700/70 py-14 lg:grid-cols-12 lg:gap-8 lg:py-24">

      <!-- LEFT SIDE -->
      <div class="relative z-10 min-w-0 lg:col-span-7">

        <p class="font-technical text-[10px] uppercase tracking-[0.24em] text-baltic-blue-700">
          Software / Sound / Creative Systems
        </p>

        <h1 class="font-brand mt-10 text-[clamp(3.4rem,9vw,10rem)] font-extrabold leading-[0.85] tracking-[-0.085em] text-baltic-blue-950">
          jenn
          <br />
          <span class="block">
            kaphammer
          </span>
        </h1>

        <p class="mt-10 max-w-md text-sm leading-7 text-baltic-blue-900 sm:text-base">
          SWE, creative, current M.S. student at CU Boulder.
          I'm most interested in the intersection of ML/SWE with audio and other creative systems.
        </p>

        <div class="mt-10 max-w-2xl">
          <MusicPlayer
            src="/debussy1.mp3"
            title="Arabesque No. 1, L. 66"
            artist="Claude Debussy"
          />
        </div>

        <a
          href="#selected-work"
          class="font-technical mt-10 inline-flex gap-3 border-b border-sky-aqua-600 pb-2 text-xs uppercase tracking-wider text-baltic-blue-900 transition-colors hover:text-sky-aqua-700"
        >
          Explore selected work ↘
        </a>

      </div>

      <!-- RIGHT SIDE PHOTO -->
      <div class="flex min-w-0 items-center justify-center lg:col-span-5 lg:justify-end">
        <div class="w-full max-w-[520px]">
          <img
            src="/jenn-photo.jpg"
            alt="Portrait of Jenn Kaphammer"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>

    </section>

    <!-- Editorial portfolio -->
    <section id="selected-work" class="py-20 lg:py-28">

      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-technical mb-4 text-[11px] uppercase tracking-widest text-sky-aqua-700">
            002 / Project Portfolio
          </p>

          <h2 class="font-expressive text-5xl font-bold tracking-tight text-baltic-blue-950 sm:text-6xl lg:text-7xl">
            selected work
          </h2>
        </div>

        <a
          href="/projects"
          class="font-technical border-b border-baltic-blue-800 pb-2 text-xs uppercase text-baltic-blue-800 hover:text-sky-aqua-700"
        >
          Full portfolio ↗
        </a>
      </div>

      <ProjectIndex projects={featuredProjects} />
    </section>

  </main>
</BaseLayout>
