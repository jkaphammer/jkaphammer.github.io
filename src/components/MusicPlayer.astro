---
interface Props {
  src: string;
  title: string;
  artist?: string;
}

const {
  src,
  title,
  artist = "Jenn Kaphammer",
} = Astro.props;
---

<div class="analog-player font-technical">
  <div class="rack-header">
    <div>
      <strong class="font-brand">JAK / AUDIO LAB</strong>
      <small>STEREO PLAYBACK MODULE — 001</small>
    </div>

    <div class="power-label">
      <span class="power-led"></span>
      POWER
    </div>
  </div>

  <div class="analog-display">
    <div class="display-header">
      <span>TRACK 01 / STEREO</span>
      <span id="audio-status">STANDBY</span>
    </div>

    <h3 class="font-editorial">{title}</h3>
    <p class="font-expressive">{artist}</p>

    <canvas
      id="level-meter"
      width="500"
      height="80"
      aria-label="Audio level visualization"
    ></canvas>

    <div class="display-footer">
      <span id="current-time">00:00</span>

      <input
        id="audio-seek"
        type="range"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Seek through track"
      />

      <span id="total-time">00:00</span>
    </div>
  </div>

  <div class="analog-controls">
    <div class="control-block">
      <span class="control-label">OUTPUT</span>

      <div class="knob-shell">
        <div id="volume-knob" class="volume-knob">
          <span class="knob-indicator"></span>
        </div>
      </div>

      <input
        id="volume-control"
        type="range"
        min="0"
        max="100"
        value="70"
        aria-label="Output volume"
      />

      <span class="control-label">LEVEL</span>
    </div>

    <div class="control-block">
      <span class="control-label">TRANSPORT</span>

      <button
        id="audio-play"
        type="button"
        class="transport-button"
        aria-label="Play audio"
      >
        <span id="transport-symbol">▷</span>
      </button>

      <span class="control-label" id="transport-label">
        PLAY
      </span>
    </div>

    <div class="control-block">
      <span class="control-label">CHANNEL</span>

      <div class="channel-display">
        <span>L</span>
        <span class="channel-light"></span>
        <span>R</span>
      </div>

      <span class="control-label">STEREO</span>
    </div>
  </div>

  <div class="rack-footer">
    <span>JAK — SIGNAL SERIES</span>
    <span>REV. 001</span>
  </div>
</div>

<style>
  .analog-player {
    --player-panel: #263c55;
    --player-panel-dark: #20344a;
    --player-screen: #0d1e30;
    --player-border: #7693a6;

    --player-text: #dbe8ed;
    --player-text-muted: #91adbd;
    --player-accent: #9fd5d8;

    background: var(--player-panel);
    color: var(--player-text);

    border: 1px solid var(--player-border);

    padding: 24px;

    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      inset 0 -1px 0 rgb(0 0 0 / 20%),
      0 14px 35px rgb(7 26 43 / 20%);
  }

  .rack-header,
  .rack-footer,
  .display-header,
  .display-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .rack-header {
    margin-bottom: 20px;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .rack-header strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .rack-header small {
    display: block;
    margin-top: 4px;

    color: var(--player-text-muted);

    font-size: 8px;
    font-weight: 400;
    letter-spacing: 0.11em;
  }

  .power-label {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--player-text-muted);

    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .power-led,
  .channel-light {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--player-accent);

    box-shadow:
      0 0 5px rgb(159 213 216 / 60%),
      0 0 12px rgb(159 213 216 / 25%);
  }

  .analog-display {
    background: var(--player-screen);

    border: 1px solid #10283b;

    padding: 18px;

    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 2%),
      inset 0 5px 18px rgb(0 0 0 / 45%);
  }

  .display-header {
    color: var(--player-text-muted);

    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .analog-display h3 {
    margin: 18px 0 0;

    color: var(--player-text);

    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .analog-display p {
    margin: 5px 0 0;

    color: #8db4c6;

    font-size: 12px;
    line-height: 1.5;
  }

  #level-meter {
    display: block;

    width: 100%;
    height: 95px;

    margin: 18px 0;
  }

  .display-footer {
    color: var(--player-accent);

    font-size: 10px;
    letter-spacing: 0.04em;
  }

  #audio-seek {
    flex: 1;
    min-width: 0;

    accent-color: var(--player-accent);

    cursor: pointer;
  }

  .analog-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 12px;

    margin-top: 16px;
  }

  .control-block {
    min-width: 0;
    min-height: 155px;

    padding: 14px 8px;

    background: var(--player-panel-dark);

    border: 1px solid #58748c;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 4%);
  }

  .control-label {
    color: #b1c7d2;

    font-size: 8px;
    font-weight: 450;
    letter-spacing: 0.12em;

    text-align: center;
    text-transform: uppercase;
  }

  .knob-shell {
    position: relative;

    width: 68px;
    height: 68px;

    border: 1px solid #7490a5;
    border-radius: 50%;

    display: grid;
    place-items: center;

    background: #1b3044;

    box-shadow:
      inset 0 2px 7px rgb(0 0 0 / 35%);
  }

  .volume-knob {
    position: relative;

    width: 54px;
    height: 54px;

    border: 2px solid #c2d0d7;
    border-radius: 50%;

    background:
      radial-gradient(
        circle at 35% 25%,
        #b5cbd2,
        #647f91 62%,
        #344f62
      );

    box-shadow:
      inset 1px 1px 1px rgb(255 255 255 / 20%),
      2px 4px 6px rgb(0 0 0 / 35%);

    transform: rotate(54deg);
  }

  .knob-indicator {
    position: absolute;

    width: 3px;
    height: 15px;

    left: calc(50% - 1.5px);
    top: 5px;

    background: #f0f7f8;

    border-radius: 2px;
  }

  #volume-control {
    width: min(95%, 105px);

    accent-color: var(--player-accent);

    cursor: pointer;
  }

  .transport-button {
    width: 64px;
    height: 64px;

    border: 1px solid #a9beca;

    background:
      linear-gradient(
        180deg,
        #688699,
        #3c596f
      );

    color: #edf8f8;

    font-size: 22px;

    cursor: pointer;

    box-shadow:
      0 5px 0 #142638,
      inset 0 1px 0 rgb(255 255 255 / 18%);

    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      background 150ms ease;
  }

  .transport-button:hover {
    background:
      linear-gradient(
        180deg,
        #7493a5,
        #45647a
      );
  }

  .transport-button:active {
    transform: translateY(4px);

    box-shadow:
      0 1px 0 #142638,
      inset 0 1px 0 rgb(255 255 255 / 12%);
  }

  .channel-display {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 12px;

    background: #102439;

    border: 1px solid #55728a;

    color: var(--player-text-muted);

    font-size: 11px;
  }

  .rack-footer {
    margin-top: 22px;
    padding-top: 14px;

    border-top: 1px solid rgb(120 145 164 / 35%);

    color: #97afc0;

    font-size: 8px;
    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  @media (max-width: 420px) {
    .analog-player {
      padding: 12px;
    }

    .analog-controls {
      gap: 6px;
    }

    .control-block {
      padding: 12px 4px;
    }

    .knob-shell {
      width: 58px;
      height: 58px;
    }

    .volume-knob {
      width: 46px;
      height: 46px;
    }

    .transport-button {
      width: 52px;
      height: 52px;
    }

    .rack-header strong {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .transport-button {
      transition: none;
    }
  }
</style>

<script>
  function initializePlayer() {
    const audio =
      document.querySelector<HTMLAudioElement>("#global-audio");

    const play =
      document.querySelector<HTMLButtonElement>("#audio-play");

    const symbol =
      document.querySelector<HTMLElement>("#transport-symbol");

    const label =
      document.querySelector<HTMLElement>("#transport-label");

    const status =
      document.querySelector<HTMLElement>("#audio-status");

    const volume =
      document.querySelector<HTMLInputElement>("#volume-control");

    const knob =
      document.querySelector<HTMLElement>("#volume-knob");

    const seek =
      document.querySelector<HTMLInputElement>("#audio-seek");

    const current =
      document.querySelector<HTMLElement>("#current-time");

    const total =
      document.querySelector<HTMLElement>("#total-time");

    const meter =
      document.querySelector<HTMLCanvasElement>("#level-meter");

    if (
      !audio ||
      !play ||
      !symbol ||
      !label ||
      !status ||
      !volume ||
      !knob ||
      !seek ||
      !current ||
      !total ||
      !meter
    ) {
      return;
    }

    if (play.dataset.initialized === "true") {
      return;
    }

    play.dataset.initialized = "true";

    const context = meter.getContext("2d");

    let audioContext: AudioContext | undefined;
    let analyser: AnalyserNode | undefined;
    let animationId = 0;
    let disposed = false;

    const formatTime = (value: number): string => {
      if (!Number.isFinite(value)) {
        return "00:00";
      }

      const minutes = Math.floor(value / 60);
      const seconds = Math.floor(value % 60);

      return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(seconds).padStart(2, "0")
      );
    };

    const updateTransport = () => {
      const playing = !audio.paused;

      symbol.textContent = playing ? "||" : "▷";
      label.textContent = playing ? "PAUSE" : "PLAY";

      play.setAttribute(
        "aria-label",
        playing ? "Pause audio" : "Play audio"
      );

      status.textContent =
        playing ? "PLAYING" : "STANDBY";
    };

    const updateProgress = () => {
      current.textContent =
        formatTime(audio.currentTime);

      if (
        Number.isFinite(audio.duration) &&
        audio.duration > 0
      ) {
        seek.value = String(
          (audio.currentTime / audio.duration) * 100
        );
      }
    };

    const updateVolume = () => {
      const amount = Number(volume.value);

      audio.volume = amount / 100;

      const rotation =
        -135 + amount * 2.7;

      knob.style.transform =
        `rotate(${rotation}deg)`;
    };

    type AudioGraph = {
      context: AudioContext;
      analyser: AnalyserNode;
    };

    const audioWindow =
      window as typeof window & {
        __audioGraph?: AudioGraph;
      };

    const initializeMeter = () => {
      if (audioWindow.__audioGraph) {
        audioContext =
          audioWindow.__audioGraph.context;

        analyser =
          audioWindow.__audioGraph.analyser;

        return;
      }

      audioContext = new AudioContext();

      const source =
        audioContext.createMediaElementSource(audio);

      analyser = audioContext.createAnalyser();

      analyser.fftSize = 4096;
      analyser.smoothingTimeConstant = 0.75;
      analyser.minDecibels = -90;
      analyser.maxDecibels = -15;

      source.connect(analyser);
      analyser.connect(audioContext.destination);

      audioWindow.__audioGraph = {
        context: audioContext,
        analyser,
      };
    };

    const drawMeter = () => {
      if (
        !context ||
        !analyser ||
        !audioContext ||
        disposed
      ) {
        return;
      }

      const data =
        new Uint8Array(
          analyser.frequencyBinCount
        );

      analyser.getByteFrequencyData(data);

      const w = meter.width;
      const h = meter.height;

      context.clearRect(0, 0, w, h);

      const bars = 24;
      const gap = 2;

      const barWidth =
        (w - gap * (bars - 1)) / bars;

      const minFrequency = 30;

      const maxFrequency = Math.min(
        20000,
        audioContext.sampleRate / 2
      );

      const binWidth =
        audioContext.sampleRate /
        analyser.fftSize;

      for (let i = 0; i < bars; i++) {
        const lowFrequency =
          minFrequency *
          Math.pow(
            maxFrequency / minFrequency,
            i / bars
          );

        const highFrequency =
          minFrequency *
          Math.pow(
            maxFrequency / minFrequency,
            (i + 1) / bars
          );

        const startBin = Math.max(
          1,
          Math.floor(
            lowFrequency / binWidth
          )
        );

        const endBin = Math.min(
          data.length - 1,
          Math.max(
            startBin,
            Math.ceil(
              highFrequency / binWidth
            )
          )
        );

        let sum = 0;
        let count = 0;

        for (
          let bin = startBin;
          bin <= endBin;
          bin++
        ) {
          const value =
            data[bin] / 255;

          sum += value * value;
          count++;
        }

        const level =
          Math.sqrt(
            sum /
            Math.max(1, count)
          );

        const barHeight = Math.max(
          2,
          Math.min(
            h - 8,
            level * (h - 8)
          )
        );

        if (highFrequency < 250) {
          context.fillStyle = "#9FD5D8";
        } else if (
          highFrequency < 4000
        ) {
          context.fillStyle = "#86A9DB";
        } else {
          context.fillStyle = "#C1B7E4";
        }

        context.fillRect(
          i * (barWidth + gap),
          h - barHeight,
          barWidth,
          barHeight
        );
      }

      if (
        !audio.paused &&
        !disposed
      ) {
        animationId =
          requestAnimationFrame(drawMeter);
      }
    };

    const stopMeter = () => {
      cancelAnimationFrame(animationId);

      animationId = 0;

      if (context) {
        context.clearRect(
          0,
          0,
          meter.width,
          meter.height
        );
      }
    };

    const syncVisualState = () => {
      updateTransport();
      updateProgress();

      volume.value =
        String(
          Math.round(
            audio.volume * 100
          )
        );

      const amount =
        Number(volume.value);

      const rotation =
        -135 + amount * 2.7;

      knob.style.transform =
        `rotate(${rotation}deg)`;

      if (
        Number.isFinite(audio.duration) &&
        audio.duration > 0
      ) {
        total.textContent =
          formatTime(audio.duration);
      }

      if (!audio.paused) {
        initializeMeter();

        if (
          audioContext?.state ===
          "suspended"
        ) {
          void audioContext.resume();
        }

        cancelAnimationFrame(animationId);
        drawMeter();
      }
    };

    volume.addEventListener(
      "input",
      updateVolume
    );

    seek.addEventListener(
      "input",
      () => {
        if (
          Number.isFinite(audio.duration) &&
          audio.duration > 0
        ) {
          audio.currentTime =
            (Number(seek.value) / 100) *
            audio.duration;
        }
      }
    );

    audio.addEventListener(
      "loadedmetadata",
      () => {
        total.textContent =
          formatTime(audio.duration);
      }
    );

    audio.addEventListener(
      "timeupdate",
      updateProgress
    );

    play.addEventListener(
      "click",
      async () => {
        if (audio.paused) {
          try {
            initializeMeter();

            if (
              audioContext?.state ===
              "suspended"
            ) {
              await audioContext.resume();
            }

            await audio.play();
          } catch (error) {
            status.textContent =
              "PLAYBACK ERROR";

            console.error(
              "Audio playback failed:",
              error
            );
          }
        } else {
          audio.pause();
        }
      }
    );

    audio.addEventListener(
      "play",
      () => {
        updateTransport();

        cancelAnimationFrame(animationId);
        drawMeter();
      }
    );

    audio.addEventListener(
      "pause",
      () => {
        updateTransport();
        stopMeter();
      }
    );

    audio.addEventListener(
      "ended",
      () => {
        updateTransport();
        updateProgress();
        stopMeter();
      }
    );

    audio.addEventListener(
      "error",
      () => {
        status.textContent =
          "AUDIO ERROR";

        stopMeter();
      }
    );

    syncVisualState();
  }

  document.addEventListener(
    "astro:page-load",
    initializePlayer
  );

  initializePlayer();
</script>