---
import MusicPlayer from "./MusicPlayer.astro";
---
<div class="relative overflow-hidden bg-[#172f4d] p-4 text-sky-aqua-100 sm:p-5">
  <div class="font-technical mb-5 flex justify-between text-[10px] uppercase tracking-widest">
    <span>Fig. 001</span>
    <span>Signal study</span>
  </div>
  <MusicPlayer
    src="/debussy1.mp3"
    title="Arabesque No. 1, L. 66"
    artist="Claude Debussy (from classicals.de)"
  />
  <canvas
    id="signal-canvas"
    class="block h-56 w-full touch-none sm:h-72"
    aria-label="Animated layered waveform visualization"
  ></canvas>

  <div class="font-technical mt-5 flex flex-wrap items-center justify-between gap-3 text-[10px] uppercase tracking-widest">
    <span>Move pointer to modulate</span>
    <button
      id="signal-toggle"
      type="button"
      aria-pressed="false"
      class="border-b border-sky-aqua-300 pb-1 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      Pause motion
    </button>
  </div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#signal-canvas");
  const toggle = document.querySelector<HTMLButtonElement>("#signal-toggle");

  if (canvas && toggle) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const colors = ["#a0d6e5", "#86a9db", "#c1b7e4", "#d4e9e5"];
      let running = !reducedMotion;
      let phase = 0;
      let amplitude = 0.65;
      let frequency = 1;
      let frame = 0;

      function resize() {
        if (!canvas || !ctx) return;

        const rect = canvas.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.max(1, Math.round(rect.width * ratio));
        canvas.height = Math.max(1, Math.round(rect.height * ratio));

        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        draw();
      }

      function draw() {
        if (!canvas || !ctx) return;

        const w = canvas.clientWidth;
        const h = canvas.clientHeight;

        ctx.clearRect(0, 0, w, h);

        // Central reference line
        ctx.strokeStyle = "rgba(188, 220, 235, 0.16)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, h / 2);
        ctx.lineTo(w, h / 2);
        ctx.stroke();

        for (let layer = 0; layer < 4; layer++) {
          ctx.beginPath();
          ctx.strokeStyle = colors[layer];
          ctx.lineWidth = layer === 0 ? 2 : 1.3;

          for (let x = 0; x <= w; x += 2) {
            const normalizedX = x / Math.max(w, 1);

            const envelope = Math.sin(Math.PI * normalizedX);
            const wave =
              Math.sin(
                normalizedX * Math.PI * 2 * (frequency * 3 + layer * 0.3) +
                phase +
                layer * 0.7
              ) *
              Math.cos(normalizedX * Math.PI * 3 + phase * 0.3);

            const y =
              h / 2 +
              wave * envelope * amplitude * (h * 0.32 - layer * 5);

            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }

          ctx.stroke();
        }
      }

      function animate() {
        if (!running) return;
        phase += 0.018;
        draw();
        frame = requestAnimationFrame(animate);
      }

      canvas.addEventListener("pointermove", (event) => {
        const rect = canvas.getBoundingClientRect();

        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;

        frequency = 0.5 + x * 2.5;
        amplitude = 0.2 + (1 - y) * 0.8;

        if (!running) draw();
      });

      toggle.addEventListener("click", () => {
        running = !running;
        toggle.setAttribute("aria-pressed", String(!running));
        toggle.textContent = running ? "Pause motion" : "Play motion";

        if (running) animate();
        else cancelAnimationFrame(frame);
      });

      toggle.textContent = running ? "Pause motion" : "Play motion";
      resize();

      if (running) animate();

      const observer = new ResizeObserver(resize);
      observer.observe(canvas);

      document.addEventListener("astro:before-swap", () => {
        running = false;
        cancelAnimationFrame(frame);
        observer.disconnect();
      }, { once: true });
    }
  }
</script>
