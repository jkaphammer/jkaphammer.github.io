---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="divide-y divide-baltic-blue-300/70 border-t border-baltic-blue-300/70">
  {projects.map((project, index) => (
    <article
      class="project-row grid gap-6 py-10 lg:grid-cols-12 lg:gap-8"
      data-tags={JSON.stringify(project.tags)}
    >
      <!-- INDEX / YEAR -->
      <div class="lg:col-span-2">
        <div class="font-technical flex flex-wrap items-center gap-3 text-[10px] uppercase tracking-wider text-baltic-blue-500">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <span>/</span>
          <span>{project.year}</span>
        </div>
      </div>

      <!-- MAIN PROJECT INFO -->
      <div class="min-w-0 lg:col-span-7">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="font-expressive text-2xl font-semibold tracking-tight text-baltic-blue-950 sm:text-3xl">
            {project.title}
          </h2>

          {project.status === "In Progress" && (
            <span class="font-technical border border-midnight-violet-300 px-2 py-1 text-[8px] uppercase tracking-widest text-midnight-violet-600">
              In Progress
            </span>
          )}
        </div>

        <p class="mt-4 max-w-2xl text-sm leading-7 text-baltic-blue-700">
          {project.description}
        </p>

        <!-- TECH STACK -->
        {project.techStack?.length > 0 && (
          <div class="mt-6">
            <p class="font-technical mb-3 text-[9px] uppercase tracking-[0.18em] text-baltic-blue-500">
              Tech Stack
            </p>

            <div class="flex flex-wrap gap-2">
              {project.techStack.map((tech) => (
                <span class="font-technical border border-baltic-blue-300/70 px-2.5 py-1.5 text-[9px] uppercase tracking-wide text-baltic-blue-600">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- CATEGORY TAGS -->
        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
          {project.tags.map((tag) => (
            <span class="font-technical text-[9px] uppercase tracking-wider text-sky-aqua-700">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- LINKS -->
      <div class="font-technical flex flex-col items-start gap-3 text-[10px] uppercase tracking-wider lg:col-span-3 lg:items-end">
        {project.href && (
          <a
            href={project.href}
            class="border-b border-baltic-blue-400 pb-1 text-baltic-blue-700 transition-colors hover:border-sky-aqua-600 hover:text-sky-aqua-700"
          >
            View Project ↗
          </a>
        )}

        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-baltic-blue-400 pb-1 text-baltic-blue-700 transition-colors hover:border-sky-aqua-600 hover:text-sky-aqua-700"
          >
            GitHub ↗
          </a>
        )}

        {project.video && (
          <a
            href={project.video}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-baltic-blue-400 pb-1 text-baltic-blue-700 transition-colors hover:border-sky-aqua-600 hover:text-sky-aqua-700"
          >
            Performance ↗
          </a>
        )}
      </div>
    </article>
  ))}
</div>