
---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="border-b border-baltic-blue-700/70">
  {projects.map((project, index) => {
    const destination = project.href ?? project.github ?? project.demo;
    const external = destination?.startsWith("http");

    return (
      <article
        class="project-row group border-t border-baltic-blue-300/70"
        data-tags={JSON.stringify(project.tags)}
      >
        <div class="grid gap-5 py-9 md:grid-cols-[4rem_minmax(0,1fr)_auto] md:items-start md:gap-8">
          <span class="font-technical text-sm text-sky-aqua-700">
            {String(index + 1).padStart(2, "0")}
          </span>

          <div class="min-w-0">
            <p class="font-technical mb-3 text-[11px] uppercase tracking-wide text-baltic-blue-600">
              {project.category} / {project.year}
            </p>

            <h3 class="font-expressive text-3xl font-bold leading-tight tracking-tight text-baltic-blue-950 transition-colors group-hover:text-midnight-violet-600 sm:text-5xl">
              {destination ? (
                <a
                  href={destination}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  {project.title}
                </a>
              ) : (
                project.title
              )}
            </h3>

            <p class="mt-4 max-w-xl text-sm leading-7 text-baltic-blue-700">
              {project.description}
            </p>

            <div class="font-technical mt-5 flex flex-wrap gap-x-4 gap-y-2 text-[11px] text-baltic-blue-600">
              {project.tags.map((tag) => (
                <span>
                  #{tag.toLowerCase().replace(/\s+/g, "-")}
                </span>
              ))}
            </div>
          </div>

          <div class="flex items-center justify-between gap-5 md:justify-end">
            <span class="font-technical text-xs text-baltic-blue-600">
              {project.year}
            </span>

            {destination && (
              <span
                aria-hidden="true"
                class="text-3xl text-sky-aqua-700 transition-transform duration-200 group-hover:-translate-y-1 group-hover:translate-x-1"
              >
                ↗
              </span>
            )}
          </div>
        </div>
      </article>
    );
  })}
</div>
